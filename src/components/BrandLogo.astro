---
import { brand } from '../data/brand';
import { company } from '../data/company';

interface Props {
  className?: string;
  sizes?: string;
}

const { className, sizes = '(max-width: 760px) 116px, 138px' } = Astro.props;
const { src, width, height } = brand.logoFallback;
---
<img
  class:list={['company-logo', className]}
  src={src}
  srcset={brand.logoSrcset}
  sizes={sizes}
  width={width}
  height={height}
  alt={company.name}
  decoding="async"
/>
