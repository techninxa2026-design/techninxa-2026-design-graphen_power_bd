---
import { company } from '../data/company';

interface Props {
  className?: string;
  sizes?: string;
}

const { className, sizes = '(max-width: 760px) 116px, 138px' } = Astro.props;
const standardLogo = '/brand/graphene-logo-standard.png';
---
<img
  class:list={['company-logo', className]}
  src={standardLogo}
  srcset={`${standardLogo} 239w, /brand/graphene-logo-medium.png 478w, ${company.logo} 956w`}
  sizes={sizes}
  width="239"
  height="109"
  alt={company.name}
  decoding="async"
/>
