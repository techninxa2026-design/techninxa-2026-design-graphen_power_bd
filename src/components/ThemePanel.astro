---
import { brandPalette, themePresets } from '../data/theme';

const fields = [
  ['primary', 'Primary', 'Backgrounds & gradients'],
  ['secondary', 'Secondary', 'Actions & highlights'],
  ['accent', 'Accent', 'Details & accents'],
] as const;
---
<dialog id="theme-dialog" class="theme-dialog" aria-labelledby="theme-title">
 <div class="theme-top"><div><div class="theme-kicker">GRAPHENE / PERSONALIZE</div><h2 id="theme-title">Make it<br/><em>yours.</em></h2></div><button type="button" class="theme-close" aria-label="Close theme editor">×</button></div>
 <div class="theme-preview" aria-hidden="true"><div class="theme-preview-wave"></div><span>YOUR PALETTE</span><strong>Energy in<br/>motion<span>.</span></strong><i>Explore ↗</i></div>
 <div class="palette-live" aria-label="Your selected colors"><span></span><span></span><span></span></div><p>Start with Graphene’s navy, green and red, or choose your own colors.</p>
 <div class="theme-inputs">{fields.map(([key,label,help])=><label class="theme-field"><span><strong>{label}</strong><small>{help}</small></span><output data-hex={key}>{brandPalette[key].toUpperCase()}</output><input type="color" data-theme-color={key} value={brandPalette[key]} aria-label={label+' color'}/></label>)}</div>
 <div class="theme-presets-label">Curated palettes</div><div class="theme-presets">{themePresets.map(p=><button type="button" data-preset={p.colors.join(',')} aria-label={p.name+' palette'} aria-pressed={p.name==='Graphene'?'true':'false'}><span>{p.colors.map(c=><i style={'background:'+c}></i>)}</span><small>{p.name}</small></button>)}</div>
 <div class="theme-actions"><button type="button" class="theme-reset">Reset to Graphene</button><button type="button" class="theme-done">Done <span>↗</span></button></div>
 <p class="theme-status" role="status">Preferences stay on this device.</p>
</dialog>