---
import { categories, categoryUrl, serviceCategory } from '../data/categories';
import { products } from '../data/catalog';
---

<div class="system-ribbon" aria-label="Product and service categories">
  {categories.map(category => {
    const count = products.filter(product => product.group === category.name).length;
    return (
      <a class="system-tile" href={categoryUrl(category.name)} aria-labelledby={`category-${category.slug}`}>
        <div class="system-image">
          <img src={`/equipment/categories/${category.slug}.webp`} width="640" height="324" alt="" loading="lazy" decoding="async" />
          <span class="system-arrow" aria-hidden="true">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
              <path d="M6 18 18 6M8 6h10v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
        <div class="system-copy">
          <span class="system-count">{count} {category.name === serviceCategory ? 'services' : 'product families'}</span>
          <h3 id={`category-${category.slug}`}>{category.name}</h3>
          <p>{category.description}</p>
        </div>
      </a>
    );
  })}
</div>

<style>
  .system-ribbon {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
  }
  .system-ribbon .system-tile {
    --tile-muted: var(--muted);
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    min-height: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 31px 31px 31px 9px;
    background: color-mix(in srgb, var(--cream) 94%, var(--blue));
    color: var(--night);
  }
  .system-ribbon .system-tile:nth-child(4n + 2) {
    --tile-muted: #e0eaf0;
    border-radius: 31px 9px 31px 31px;
    background: var(--night);
    color: white;
  }
  .system-ribbon .system-tile:nth-child(4n + 3) {
    border-radius: 9px 31px 31px 31px;
    background: color-mix(in srgb, var(--cream) 88%, var(--cyan));
  }
  .system-ribbon .system-tile:nth-child(4n + 4) {
    border-radius: 31px 31px 9px 31px;
    background: color-mix(in srgb, var(--cream) 88%, var(--orange));
  }
  .system-image {
    position: relative;
    width: 100%;
    aspect-ratio: 640 / 324;
    overflow: hidden;
    background: var(--night);
  }
  .system-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .system-image .system-arrow {
    position: absolute;
    right: 12px;
    top: 12px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid #ffffff76;
    background: #0b171fdd;
    color: white;
  }
  .system-copy {
    padding: clamp(15px, 1.5vw, 23px);
  }
  .system-count {
    display: block;
    margin-bottom: 8px;
    color: var(--tile-muted);
    font: 700 .7rem/1.25 monospace;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .system-copy h3 {
    margin: 0 0 7px;
    font-size: clamp(1.28rem, 2.05vw, 1.95rem);
    letter-spacing: -.047em;
    line-height: 1.05;
  }
  .system-copy p {
    margin: 0;
    color: var(--tile-muted);
    font-size: clamp(.82rem, 1.14vw, .94rem);
    line-height: 1.48;
  }
  .system-ribbon .system-tile:focus-visible {
    outline: 3px solid var(--night);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .system-image img { transition: transform .45s cubic-bezier(.16,1,.3,1); }
    .system-tile:hover .system-image img { transform: scale(1.06); }
    .system-tile:hover .system-arrow {
      border-color: var(--cyan);
      background: var(--cyan);
      color: var(--night);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .system-ribbon .system-tile:hover { transform: none; }
  }
  @media (max-width: 1000px) {
    .system-ribbon { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .system-ribbon { gap: 10px; }
    .system-ribbon .system-tile { border-radius: 19px; }
    .system-copy { padding: 12px; }
    .system-image .system-arrow { width: 33px; height: 33px; top: 8px; right: 8px; }
    .system-image .system-arrow svg { width: 15px; height: 15px; }
    .system-copy h3 { font-size: 1.16rem; }
    .system-copy p { font-size: .76rem; }
    .system-count { font-size: .6rem; }
  }
</style>
