---
import {imageFor} from '../data/equipment';
const {item}=Astro.props;
const photo=imageFor(item.asset);
---
<article class="equipment-tile" data-equipment-item data-family={item.family} data-system={item.group} data-keywords={[item.name,item.familyName,item.group,photo?.credit||''].join(' ').toLowerCase()} id={item.id}>
<div class="tile-index"><span>{item.number} / {item.group}</span><a href={'/products/'+item.family+'/'} aria-label={'Technical details for '+item.familyName}>↗</a></div>
{photo?<a class:list={['tile-photo',{'tile-thumbnail':photo.width>0&&photo.width<400}]} href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={'Open source image: '+photo.alt}><img src={photo.src} alt={photo.alt} width={photo.width||640} height={photo.height||420} loading="lazy" decoding="async"/><span class="tile-photo-label">{photo.kind} · {photo.credit}</span><span class="tile-expand" aria-hidden="true">⤢</span><span class="tile-unavailable" hidden>Source image unavailable</span></a>:<div class="tile-no-photo"><span>PHOTO PENDING</span><strong>See the source<br/>catalogue.</strong><a href={item.source} target="_blank" rel="noopener noreferrer">Manufacturer / reference ↗</a></div>}
<div class="tile-info"><small>{item.familyName}</small><h3>{item.name}</h3><div class="tile-actions"><a href={'/products/'+item.family+'/#technical'}>Technical details ↗</a><a href={'/contact/?product='+item.family+'&variant='+encodeURIComponent(item.name)}>Inquire <span>↗</span></a></div>{photo&&<a class="tile-source" href={photo.source} target="_blank" rel="noopener noreferrer">Image source: {photo.credit} ↗</a>}</div>
</article>