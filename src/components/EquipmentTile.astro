---
import {imageFor} from '../data/equipment';
const {item}=Astro.props;
const photo=imageFor(item.asset);
const fallbackImages=(item.imageFallbacks||[]).map((key:string)=>imageFor(key)).filter(Boolean);
const matchLabels:Record<string,string>={subtype:'Product-type example',family:'Related family example',context:'System context'};
const match=matchLabels[item.imageMatch]||'Reference example';
---
<article class="equipment-tile" data-equipment-item data-family={item.family} data-system={item.group} data-keywords={[item.name,item.familyName,item.group,photo?.credit||''].join(' ').toLowerCase()} id={item.id}>
<div class="tile-index"><span>{item.number} / {item.group}</span><a href={'/products/'+item.family+'/'} aria-label={'Technical details for '+item.familyName}>↗</a></div>
{photo?<a class:list={['tile-photo',{'tile-thumbnail':photo.width>0&&photo.width<400}]} href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={'Open reference image: '+photo.alt}><img src={photo.src} alt={photo.alt} width={photo.width||640} height={photo.height||420} loading="lazy" decoding="async" data-image-fallbacks={JSON.stringify(fallbackImages)}/><span class="tile-photo-label">{match} · {photo.credit}</span><span class="tile-expand" aria-hidden="true">⤢</span><span class="tile-unavailable" hidden>Reference photo temporarily unavailable</span></a>:<div class="tile-no-photo"><span>PHOTO UNAVAILABLE</span><strong>Explore the equipment guide.</strong><a href={item.source} download>Graphene catalogue ↓</a></div>}
<div class="tile-info"><small>{item.familyName}</small><h3>{item.name}</h3><div class="tile-actions"><a href={'/products/'+item.family+'/#technical'}>Technical details ↗</a><a href={'/contact/?product='+item.family+'&variant='+encodeURIComponent(item.name)}>Inquire <span>↗</span></a></div><a class="tile-source" href={item.source} download={item.source.endsWith(".pdf") || undefined}>{item.source.endsWith(".pdf") ? "Graphene catalogue ↓" : "Product guide ↗"}</a>{photo&&<a class="tile-source image-attribution" href={photo.source} target="_blank" rel="noopener noreferrer">Image: {photo.alt} · {photo.credit}{photo.license?' · '+photo.license:''} ↗</a>}</div>
</article>