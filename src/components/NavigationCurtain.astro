---
import BrandLogo from './BrandLogo.astro';
---
<div class="navigation-curtain" id="navigation-curtain" aria-hidden="true">
  <div class="nav-curtain-skin"></div>
  <svg class="nav-curtain-flow" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M-180 730 C240 960 465 35 875 280 S1290 725 1630 80" fill="none" stroke="var(--palette-primary,var(--blue))" stroke-width="200" opacity=".5"/><path d="M-180 730 C240 960 465 35 875 280 S1290 725 1630 80" fill="none" stroke="var(--palette-secondary,var(--cyan))" stroke-width="2" opacity=".8"/><path d="M-180 780 C240 1010 465 85 875 330 S1290 775 1630 130" fill="none" stroke="var(--palette-accent,var(--orange))" stroke-width="1.5" opacity=".55"/></svg>
  <div class="nav-curtain-content"><BrandLogo className="curtain-company-logo" sizes="(max-width: 410px) 78vw, 320px" /><strong data-navigation-title>Explore.</strong><div class="nav-curtain-line"><i></i></div></div>
  <div class="nav-curtain-edge"></div>
</div>