---
import EquipmentPhoto from './EquipmentPhoto.astro';
const {product:p}=Astro.props;
---
<a class="product-card" href={'/products/'+p.slug+'/'} data-product data-group={p.group} data-search={[p.name,p.description,...p.variants].join(' ').toLowerCase()}>
<div class="product-top"><span>{p.number} / {p.group}</span><span class="round-arrow">↗</span></div>
<EquipmentPhoto slug={p.slug} name={p.name}/>
<div class="product-copy"><h3>{p.name}</h3><p>{p.description}</p></div></a>