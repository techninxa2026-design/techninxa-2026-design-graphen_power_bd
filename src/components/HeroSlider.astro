---
import { company } from '../data/company';
import { portfolioPhotos } from '../data/portfolio-photos';

const slideDuration = 8500;
const slides = [
  {
    key: 'solar', label: 'Solar energy', title: 'Industrial rooftop solar',
    description: 'On-grid, off-grid and hybrid systems.',
    href: '/products/?system=Renewable%20energy',
    photo: portfolioPhotos.rooftopSolar, width: 1920, position: '50% 51%',
  },
  {
    key: 'substations', label: 'Substations', title: 'Substations & distribution',
    description: 'Transformers, switchgear and power factor correction.',
    href: '/products/substations/',
    photo: portfolioPhotos.substationTransformer, width: 1920, position: '50% 53%',
  },
  {
    key: 'lightning', label: 'Lightning protection', title: 'Lightning protection',
    description: 'Air terminals, bonding and earthing systems.',
    href: '/products/lightning-protection/',
    photo: portfolioPhotos.lightningTerminal, width: 1680, position: '50% 45%',
  },
  {
    key: 'engineering', label: 'Engineering services', title: 'Testing & installation',
    description: 'Resistance testing, consultancy and turnkey installation.',
    href: '/services/',
    photo: portfolioPhotos.substationTesting, width: 1920, position: '50% 46%',
  },
].map(slide => {
  const image = '/equipment/hero/' + slide.key;
  const wide = image + '-wide.webp';

  return {
    ...slide,
    wide,
    portrait: image + '-portrait.webp',
    height: Math.round(slide.width / 1.62),
    avif: slide.key === 'solar' || slide.key === 'substations',
    srcset: slide.key === 'lightning' ? undefined : `${slide.photo.src} ${slide.photo.width}w, ${wide} ${slide.width}w`,
  };
});
const portraitViewport = '(max-width: 680px) and (orientation: portrait)';
---

<section class="home-hero motion-hero" id="overview" data-rail="Home" data-hero-carousel
  data-interval={slideDuration} style={`--slide-duration:${slideDuration}ms`}
  aria-label="Featured products and services" aria-roledescription="carousel">
  <div class="hero-backdrops" aria-hidden="true">
    {slides.map((slide, index) => {
      const Media = index === 0 ? 'div' : 'template';
      return (
        <div class="hero-backdrop" data-hero-backdrop data-active={index === 0 || undefined}
          style={`--focal-point:${slide.position}`}>
          <Media>
            <picture>
              {slide.avif && <source media={portraitViewport} type="image/avif" srcset={slide.portrait.replace('.webp', '.avif')} />}
              <source media={portraitViewport} srcset={slide.portrait} />
              {slide.avif && <source type="image/avif" srcset={slide.wide.replace('.webp', '.avif')} />}
              <img src={slide.wide} srcset={slide.srcset} sizes="100vw" width={slide.width}
                height={slide.height} alt="" fetchpriority={index === 0 ? 'high' : 'low'}
                decoding={index === 0 ? undefined : 'async'} />
            </picture>
          </Media>
        </div>
      );
    })}
  </div>

  <div class="hero-content wrap">
    <div class="motion-copy">
      <p class="motion-label"><span></span> {company.name}</p>
      <h1 id="hero-title" aria-label="Energy in motion.">
        <span class="sequence-line" aria-hidden="true"><span class="sequence-word">Energy</span></span>
        <span class="sequence-line" aria-hidden="true"><span class="sequence-word">in <em>motion<span>.</span></em></span></span>
      </h1>
      <p class="motion-description">Power distribution, industrial machinery and renewable energy for businesses across Bangladesh.</p>
      <div class="motion-actions">
        <a class="action-primary" href="/products/">
          Explore products
          <span aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
        <a class="hero-services" href="/services/">View services</a>
      </div>
    </div>

    <div class="hero-spotlight" id="hero-spotlight">
      {slides.map((slide, index) => (
        <div class="hero-caption" data-hero-caption hidden={index > 0} role="group" aria-roledescription="slide"
          aria-label={`${slide.title}, ${index + 1} of ${slides.length}`}>
          <a class="hero-feature" href={slide.href}>
            <span>
              <strong data-hero-title>{slide.title}</strong>
              <span>{slide.description}</span>
            </span>
            <span class="hero-feature-arrow" aria-hidden="true">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                <path d="M6 18 18 6M8 6h10v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
          <a class="hero-credit" href={slide.photo.source} target="_blank" rel="noopener noreferrer"
            aria-label={`Reference photo by ${slide.photo.credit}`}>Photo credit</a>
        </div>
      ))}
    </div>
  </div>

  <div class="hero-toolbar wrap" data-hero-controls hidden>
    <button class="hero-icon-button hero-toggle" type="button" data-hero-rotate aria-label="Pause slideshow" aria-controls="hero-spotlight">
      <svg data-icon-pause width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 5v14m6-14v14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <svg data-icon-play width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m9 5 11 7-11 7V5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
    </button>
    <div class="hero-pickers" role="group" aria-label="Select a featured slide">
      {slides.map((slide, index) => (
        <button class="hero-picker" type="button" data-hero-pick={index} aria-label={`Show ${slide.label.toLowerCase()}`}
          aria-controls="hero-spotlight" aria-current={index === 0 ? 'true' : undefined}>
          <span class="hero-progress" aria-hidden="true"></span>
          <span class="hero-picker-label">{slide.label}</span>
        </button>
      ))}
    </div>
    <div class="hero-arrows">
      <button class="hero-icon-button" type="button" data-hero-prev aria-label="Previous slide" aria-controls="hero-spotlight">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="hero-icon-button" type="button" data-hero-next aria-label="Next slide" aria-controls="hero-spotlight">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
    <span class="hero-status" data-hero-status role="status"></span>
  </div>

  <svg class="hero-edge" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 37 C305 69 508 55 768 30 S1165 7 1440 29 V60 H0Z" fill="var(--cream)" />
  </svg>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero-carousel]');
  const toolbar = hero?.querySelector<HTMLElement>('[data-hero-controls]');
  const rotationButton = toolbar?.querySelector<HTMLButtonElement>('[data-hero-rotate]');
  const status = toolbar?.querySelector<HTMLElement>('[data-hero-status]');

  if (hero && toolbar && rotationButton && status) {
    const backdrops = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-backdrop]'));
    const captions = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-caption]'));
    const pickers = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-hero-pick]'));
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const interval = Number(hero.dataset.interval);

    let active = 0;
    let requested = 0;
    let canRotate = !reducedMotion.matches;
    let inView = !('IntersectionObserver' in window);
    let hovered = false;
    let rotationTimer = 0;
    let preloadTimer = 0;
    let revision = 0;
    let touch: { x: number; y: number; id: number } | undefined;

    const prepareImage = (index: number) => {
      const backdrop = backdrops[index];
      const template = backdrop.querySelector('template');
      if (template) template.replaceWith(template.content.cloneNode(true));
      return backdrop.querySelector('img');
    };

    const stopTimers = () => {
      window.clearTimeout(rotationTimer);
      window.clearTimeout(preloadTimer);
      hero.removeAttribute('data-rotating');
    };

    const rotationAllowed = () => canRotate && inView && !hovered && !document.hidden;

    const scheduleRotation = () => {
      stopTimers();
      if (!rotationAllowed() || requested !== active) return;

      const next = (active + 1) % backdrops.length;
      hero.setAttribute('data-rotating', '');
      preloadTimer = window.setTimeout(() => prepareImage(next), interval - 1600);
      rotationTimer = window.setTimeout(() => void show(next), interval);
    };

    const setRotation = (enabled: boolean) => {
      canRotate = enabled;
      hero.toggleAttribute('data-playing', enabled);
      rotationButton.setAttribute('aria-label', enabled ? 'Pause slideshow' : 'Play slideshow');
      scheduleRotation();
    };

    const show = async (index: number, manual = false) => {
      requested = (index + backdrops.length) % backdrops.length;
      const next = requested;
      const change = ++revision;
      if (manual) setRotation(false);
      else stopTimers();

      if (next === active) {
        scheduleRotation();
        return;
      }

      const image = prepareImage(next);
      if (image) {
        if (manual) image.fetchPriority = 'auto';
        await image.decode().catch(() => { image.hidden = true; });
      }
      if (change !== revision) return;
      if (!manual && !rotationAllowed()) {
        requested = active;
        scheduleRotation();
        return;
      }

      // A pending image request must never hide a link that has since received focus.
      if (captions[active].contains(document.activeElement)) pickers[next].focus({ preventScroll: true });
      backdrops[active].removeAttribute('data-active');
      backdrops[next].setAttribute('data-active', '');
      captions[active].hidden = true;
      captions[next].hidden = false;
      pickers[active].removeAttribute('aria-current');
      pickers[next].setAttribute('aria-current', 'true');
      active = next;
      if (manual) status.textContent = captions[active].getAttribute('aria-label');
      scheduleRotation();
    };

    toolbar.hidden = false;
    rotationButton.addEventListener('click', () => {
      if (!canRotate) hovered = false;
      setRotation(!canRotate);
    });
    toolbar.querySelector('[data-hero-prev]')?.addEventListener('click', () => void show(requested - 1, true));
    toolbar.querySelector('[data-hero-next]')?.addEventListener('click', () => void show(requested + 1, true));
    pickers.forEach((button, index) => button.addEventListener('click', () => void show(index, true)));
    toolbar.addEventListener('keydown', event => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      void show(requested + (event.key === 'ArrowLeft' ? -1 : 1), true);
    });

    hero.addEventListener('focusin', event => {
      if (event.target instanceof Element && event.target.matches(':focus-visible')) setRotation(false);
    });
    hero.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse') return;
      hovered = true;
      scheduleRotation();
    });
    hero.addEventListener('pointerleave', event => {
      if (event.pointerType !== 'mouse') return;
      hovered = false;
      scheduleRotation();
    });
    hero.addEventListener('pointerdown', event => {
      if (!event.isPrimary || event.pointerType !== 'touch') return;
      if (event.target instanceof Element && event.target.closest('a, button')) return;
      touch = { x: event.clientX, y: event.clientY, id: event.pointerId };
    });
    hero.addEventListener('pointerup', event => {
      if (!touch || touch.id !== event.pointerId) return;
      const distance = event.clientX - touch.x;
      const vertical = Math.abs(event.clientY - touch.y);
      touch = undefined;
      if (Math.abs(distance) > 48 && Math.abs(distance) > vertical * 1.4) {
        void show(requested + (distance < 0 ? 1 : -1), true);
      }
    });
    hero.addEventListener('pointercancel', () => { touch = undefined; });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) setRotation(false);
    });
    document.addEventListener('visibilitychange', scheduleRotation);
    window.addEventListener('pagehide', stopTimers);
    window.addEventListener('pageshow', scheduleRotation);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.intersectionRatio >= .4;
        scheduleRotation();
      }, { threshold: .4 }).observe(hero);
    }
    setRotation(canRotate);
  }
</script>

<style>
  .home-hero {
    --hero-ink: color-mix(in srgb, var(--night) 50%, #070d11);
    --hero-accent: color-mix(in srgb, var(--cyan) 86%, white);
    display: grid;
    grid-template-rows: 1fr auto;
    gap: clamp(24px, 6vh, 68px);
    min-height: clamp(690px, 95svh, 980px);
    padding: clamp(120px, 16vh, 180px) 0 clamp(60px, 9vh, 96px);
    color: #fff;
    background: var(--hero-ink);
    touch-action: pan-y pinch-zoom;
  }
  .hero-backdrops, .hero-backdrop, .hero-backdrops::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-backdrops {
    z-index: -1;
  }
  .hero-backdrops::after {
    content: '';
    background:
      linear-gradient(0deg, var(--hero-ink) 0%, #070d11d9 11%, #070d1130 34%, transparent 59%),
      linear-gradient(90deg, var(--hero-ink) 0%, color-mix(in srgb, var(--hero-ink) 87%, transparent) 22%, #070d116e 52%, transparent 82%),
      linear-gradient(180deg, #070d1187 0%, transparent 30%);
  }
  .hero-backdrop {
    opacity: 0;
    visibility: hidden;
    transition: opacity .68s ease, visibility 0s .68s;
  }
  .hero-backdrop[data-active] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .hero-backdrop > div { display: contents; }
  .hero-backdrop picture, .hero-backdrop img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-backdrop img {
    object-fit: cover;
    object-position: var(--focal-point);
  }
  .hero-backdrop img[hidden] { display: none; }
  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 362px);
    gap: clamp(24px, 6vw, 88px);
    align-items: center;
  }
  .home-hero .motion-copy {
    padding: 0;
  }
  .home-hero .motion-label {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin: 0 0 clamp(16px, 3vh, 32px);
    color: var(--hero-accent);
    font: 700 clamp(.62rem, 1.1vw, .75rem)/1.3 monospace;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .motion-label > span {
    width: 20px;
    height: 1px;
    flex: none;
    background: currentColor;
  }
  .home-hero .motion-copy h1 {
    margin: 0;
    font-size: clamp(4.75rem, 8.8vw, 8.75rem);
    letter-spacing: -.085em;
  }
  .home-hero .sequence-line {
    margin-inline: 0;
    padding-inline: 0;
  }
  .home-hero .motion-copy h1 em { color: var(--hero-accent); }
  .home-hero .motion-description {
    display: block;
    margin: clamp(12px, 3vh, 24px) 0 clamp(19px, 3.2vh, 32px);
    max-width: 37ch;
    color: #ecf1f5;
    font-size: clamp(.95rem, 1.5vw, 1.16rem);
    line-height: 1.58;
  }
  .home-hero .motion-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .7rem 1.25rem;
  }
  .hero-services {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #fff;
    font-size: .875rem;
    font-weight: 700;
    text-underline-offset: .4em;
    text-decoration: underline;
    text-decoration-color: #ffffff72;
  }
  .hero-services:hover { color: var(--hero-accent); }
  .hero-spotlight {
    align-self: end;
    justify-self: end;
    display: grid;
    width: 100%;
    min-width: 0;
    border: 1px solid #ffffff48;
    border-radius: 22px 22px 22px 6px;
    background: #0b131bce;
    backdrop-filter: blur(12px);
  }
  .hero-caption {
    grid-area: 1 / 1;
    display: grid;
    align-content: center;
    justify-items: start;
    padding: 16px 18px 7px;
  }
  .hero-caption[hidden] {
    display: grid !important;
    visibility: hidden;
  }
  .hero-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    gap: 10px;
    align-items: center;
    width: 100%;
    color: #fff;
  }
  .hero-feature strong {
    display: block;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    letter-spacing: -.035em;
    line-height: 1.08;
  }
  .hero-feature > span:first-child > span {
    display: block;
    margin-top: .4rem;
    color: #e0e9ef;
    font-size: .82rem;
    line-height: 1.4;
  }
  .hero-feature-arrow, .hero-icon-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #ffffff61;
    background: #0e191f99;
    color: white;
  }
  .hero-feature:hover .hero-feature-arrow, .hero-icon-button:hover {
    background: var(--hero-accent);
    color: #101820;
    border-color: var(--hero-accent);
  }
  .hero-credit {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    margin-top: .15rem;
    color: #d9e2e8;
    font-size: .69rem;
    text-underline-offset: .22em;
    text-decoration: underline;
  }
  .hero-toolbar {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(8px, 2vw, 29px);
  }
  .hero-toolbar[hidden] { display: none; }
  .hero-icon-button { cursor: pointer; }
  .hero-arrows { display: flex; gap: clamp(4px, .6vw, 9px); }
  .hero-toggle [data-icon-pause], .home-hero[data-playing] .hero-toggle [data-icon-play] { display: none; }
  .home-hero[data-playing] .hero-toggle [data-icon-pause] { display: block; }
  .hero-pickers {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: clamp(6px, 2vw, 32px);
  }
  .hero-picker {
    display: grid;
    align-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #e2edf2;
    text-align: left;
    font: inherit;
    cursor: pointer;
  }
  .hero-picker-label {
    font-size: .85rem;
    font-weight: 600;
  }
  .hero-picker[aria-current], .hero-picker:hover { color: white; }
  .hero-progress {
    position: relative;
    height: 3px;
    overflow: hidden;
    border-radius: 4px;
    background: #ffffff60;
  }
  .hero-progress::after {
    position: absolute;
    inset: 0;
    content: '';
    background: var(--hero-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero-picker[aria-current] .hero-progress { background: color-mix(in srgb, var(--hero-accent) 40%, transparent); }
  .hero-picker[aria-current] .hero-progress::after { transform: scaleX(1); }
  .home-hero[data-rotating] .hero-picker[aria-current] .hero-progress::after {
    animation: fill-slide var(--slide-duration) linear both;
  }
  @keyframes fill-slide { from { transform: scaleX(0); } }
  .home-hero :is(a, button):focus-visible {
    outline: 2px solid var(--hero-accent);
    outline-offset: 4px;
  }
  .hero-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .hero-edge {
    position: absolute;
    inset: auto 0 -1px;
    height: clamp(30px, 5.5vh, 58px);
    width: 100%;
    pointer-events: none;
  }

  @media (max-width: 850px) {
    .hero-content {
      grid-template-columns: minmax(0, 1fr) minmax(210px, 260px);
      gap: 20px;
    }
    .home-hero .motion-copy h1 { font-size: clamp(3.85rem, 10vw, 6rem); }
    .hero-picker-label { font-size: .75rem; }
  }
  @media (max-width: 680px) {
    .home-hero {
      min-height: 97svh;
      gap: 15px;
      padding: clamp(150px, 22svh, 200px) 0 52px;
    }
    .hero-content {
      grid-template-columns: 1fr;
      align-content: end;
      gap: clamp(18px, 3vh, 26px);
    }
    .hero-backdrops::after {
      background:
        linear-gradient(0deg, var(--hero-ink) 0%, #070d11ed 22%, #070d11a6 62%, transparent 83%),
        linear-gradient(180deg, #070d1199 0%, transparent 27%),
        linear-gradient(90deg, #070d1166, transparent 90%);
    }
    .hero-backdrop img {
      object-position: center 35%;
    }
    .home-hero .motion-copy h1 {
      font-size: clamp(3.2rem, 14.6vw, 5.75rem);
    }
    .home-hero .motion-label { margin-bottom: .75rem; }
    .home-hero .motion-description { margin: .9rem 0 1.15rem; }
    .home-hero .motion-actions { gap: .35rem .95rem; }
    .home-hero .action-primary {
      min-height: 46px;
      padding: 5px 5px 5px 13px;
      gap: 7px;
    }
    .home-hero .action-primary > span { width: 34px; height: 34px; }
    .hero-services { font-size: .8rem; }
    .hero-caption { padding: 12px 14px 3px; }
    .hero-feature strong { font-size: 1.25rem; }
    .hero-edge { height: 33px; }
  }
  @media (max-width: 570px) {
    .hero-picker-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
  @media (max-width: 420px) and (max-height: 660px) {
    .home-hero {
      gap: 8px;
      padding: clamp(104px, 19svh, 125px) 0 28px;
    }
    .hero-content { gap: 13px; }
    .home-hero .motion-copy h1 { font-size: clamp(2.8rem, 13vw, 3.25rem); }
    .home-hero .motion-label { margin-bottom: .55rem; }
    .home-hero .motion-description {
      margin: .6rem 0 .75rem;
      font-size: .88rem;
      line-height: 1.45;
    }
    .hero-caption { padding: 9px 12px 2px; }
    .hero-feature strong { font-size: 1.08rem; }
    .hero-feature > span:first-child > span { font-size: .75rem; }
    .hero-edge { height: 23px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-caption:not([hidden]) { animation: reveal-caption .32s ease-out both; }
    @keyframes reveal-caption { from { opacity: 0; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop { transition: none; }
    .home-hero[data-rotating] .hero-picker[aria-current] .hero-progress::after { animation: none; }
  }
</style>
