---
import Site from '../../layouts/Site.astro';
import ProductCard from '../../components/ProductCard.astro';
import EquipmentPhoto from '../../components/EquipmentPhoto.astro';
import VisualGallery from '../../components/VisualGallery.astro';
import {products} from '../../data/catalog';
import {reference,referenceUrl} from '../../data/reference';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product:p}=Astro.props;
const info=reference[p.slug];
const related=products.filter(x=>x.group===p.group&&x.slug!==p.slug).slice(0,3);
---
<Site title={p.name} description={p.description}>
<section class="detail-head" id="overview" data-rail="Overview"><div class="wrap"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/products/">Products</a> / {p.name}</div><div class="detail-grid"><div><div class="eyebrow">{p.number} / {p.group} SYSTEMS</div><h1>{p.name}<em>.</em></h1><p>{info.summary}</p><div class="ref-brand">REFERENCE PORTFOLIO / {info.brand}</div><a class="button dark" href={'/contact/?product='+p.slug}>Prepare equipment inquiry ↗</a></div><div class="detail-art"><EquipmentPhoto slug={p.slug} name={p.name}/><small>REFERENCE IMAGERY / NOT VERIFIED GRAPHENE INVENTORY</small></div></div></div></section>
<section class="wrap section reference-panel" id="technical" data-rail="Technical" data-motion><div class="section-kicker"><span>01</span> / TECHNICAL REFERENCE</div><h2>Know the equipment<em>.</em></h2><p class="ref-intro">Published reference information, not a Graphene stock or performance guarantee. Confirm final selection with the supplier.</p><div class="fact-grid">{info.facts.map(([label,value])=><article><small>{label}</small><strong>{value}</strong></article>)}</div>{info.table&&<div class="ref-table" tabindex="0" role="region" aria-label="Reference specification table"><table><thead><tr>{info.table.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{info.table.rows.map(row=><tr>{row.map((v,i)=>i===0?<th scope="row">{v}</th>:<td>{v}</td>)}</tr>)}</tbody></table></div>}{info.note&&<p class="ref-note">{info.note}</p>}</section>
<section class="wrap section variant-showcase" id="equipment-gallery" data-rail="Gallery"><div class="section-heading"><div><div class="section-kicker"><span>02</span> / EQUIPMENT IMAGES</div><h2>Explore each<br/><em>configuration.</em></h2></div><a class="text-link" href="/products/gallery/">All equipment ↗</a></div><VisualGallery family={p.slug}/></section><section class="wrap section detail-body" id="configurations" data-rail="Configurations" data-motion><div><div class="eyebrow">02 / CONFIGURATIONS</div><h2>Explore the range.</h2><div class="variant-list">{p.variants.map((v,i)=><div><small>{String(i+1).padStart(2,'0')}</small><strong>{v}</strong></div>)}</div></div><div><div class="eyebrow">03 / TECHNICAL SELECTION</div><h2>What to specify.</h2><p>Collect these project-specific parameters before requesting a model and quotation.</p><dl class="spec-list">{p.specs.map(s=><div><dt>{s}</dt><dd>Confirm for selected model</dd></div>)}</dl></div></section>
<section class="wrap reference-download" id="documents" data-rail="Documents" data-motion><div><div class="section-kicker"><span>04</span> / SOURCE LIBRARY</div><h2>Go deeper.</h2><p>External manufacturer documents and reference information. Availability and model revisions are controlled by the source.</p></div><div class="ref-links"><a href={referenceUrl} target="_blank" rel="noopener noreferrer">Powerbreeze product reference <span>↗</span></a>{info.links.map(([label,url])=><a href={url} target="_blank" rel="noopener noreferrer">{label}<span>↗</span></a>)}</div></section>
<section class="wrap section" id="related" data-rail="Related"><div class="section-heading"><h2>Related equipment.</h2><a class="text-link" href="/products/">All products ↗</a></div><div class="product-grid">{related.map(product=><ProductCard {product}/>)}</div></section></Site>