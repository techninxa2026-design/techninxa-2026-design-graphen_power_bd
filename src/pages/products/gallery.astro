---
import Site from '../../layouts/Site.astro';
import VisualGallery from '../../components/VisualGallery.astro';
import {equipment} from '../../data/equipment';
import {products,groups} from '../../data/catalog';
---
<Site title="Visual equipment catalogue"><section class="page-head" id="overview" data-rail="Overview"><div class="wrap"><a class="crumb" href="/products/">Products</a> / Visual catalogue<div class="eyebrow light">THE EQUIPMENT LIBRARY / {equipment.length} ENTRIES</div><h1>See the<br/><em>equipment.</em></h1><p>Explore equipment types, named series and manufacturer images across the complete reference portfolio. Source images are identified; unavailable photography is not replaced with unrelated pictures.</p></div></section><section class="wrap section visual-library" id="gallery" data-rail="Gallery"><div class="visual-controls"><label class="search">⌕ <input id="visual-search" type="search" placeholder="Find a product or model..." aria-label="Search equipment"/></label><label class="visual-select">Product family<select id="visual-family"><option value="">All families</option>{products.map(p=><option value={p.slug}>{p.name}</option>)}</select></label><label class="visual-select">Engineering system<select id="visual-system"><option value="">All systems</option>{groups.map(g=><option value={g}>{g}</option>)}</select></label></div><p class="result-count" id="visual-count" aria-live="polite">{equipment.length} equipment entries</p><VisualGallery/><p id="visual-empty" hidden>No matching equipment. Try another filter.</p><p class="gallery-disclosure">Reference and manufacturer imagery for evaluation. Model availability and rights to publish imagery must be confirmed.</p></section></Site>
<script>
const search=document.querySelector<HTMLInputElement>('#visual-search'),family=document.querySelector<HTMLSelectElement>('#visual-family'),system=document.querySelector<HTMLSelectElement>('#visual-system');const items=Array.from(document.querySelectorAll<HTMLElement>('[data-equipment-item]'));const count=document.querySelector('#visual-count'),empty=document.querySelector<HTMLElement>('#visual-empty');function filter(){let n=0;for(const el of items){const show=(!family?.value||el.dataset.family===family.value)&&(!system?.value||el.dataset.system===system.value)&&(el.dataset.keywords||'').includes((search?.value||'').trim().toLowerCase());const was=el.hidden;el.hidden=!show;if(show){n++;if(was&&!matchMedia('(prefers-reduced-motion: reduce)').matches){el.classList.remove('filter-enter');void el.offsetWidth;el.classList.add('filter-enter');}}}if(count)count.textContent=n+' equipment '+(n===1?'entry':'entries');if(empty)empty.hidden=n!==0;}const requested=new URLSearchParams(location.search).get('family');if(family&&requested&&Array.from(family.options).some(o=>o.value===requested))family.value=requested;filter();search?.addEventListener('input',filter);family?.addEventListener('change',filter);system?.addEventListener('change',filter);
</script>