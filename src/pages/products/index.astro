---
import Site from '../../layouts/Site.astro';
import ProductCard from '../../components/ProductCard.astro';
import {products,groups} from '../../data/catalog';
---
<Site title="Equipment catalogue"><section class="page-head" id="overview" data-rail="Overview"><div class="wrap"><a class="crumb" href="/">Home</a> / Products<div class="eyebrow light">01 / PRODUCT DIRECTORY</div><h1>Equipment<br/><em>that moves industry.</em></h1><p>Explore {products.length} product families, find the right equipment and prepare your technical requirements.</p><a href="/products/gallery/" class="button">Explore every product type ↗</a></div></section><section class="wrap section catalogue" id="catalogue" data-rail="Catalogue"><div class="filterbar"><label class="search"><span>⌕</span><input type="search" id="product-search" placeholder="Search equipment, e.g. generator" aria-label="Search products"/></label><div class="filters" aria-label="Filter by system"><button data-filter="All" aria-pressed="true">All systems</button>{groups.map(group=><button data-filter={group} aria-pressed="false">{group}</button>)}</div></div><p id="results" class="result-count" aria-live="polite">{products.length} product families</p><div class="product-grid">{products.map(product=><ProductCard {product}/>)}</div><p id="empty" hidden>No equipment matches. Try a different search or system.</p></section></Site>
<script>
let group='All';const search=document.querySelector<HTMLInputElement>('#product-search');const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const cards=document.querySelectorAll<HTMLElement>('[data-product]');
function filter(){let n=0;const q=(search?.value||'').trim().toLowerCase();cards.forEach(card=>{const visible=(group==='All'||card.dataset.group===group)&& (card.dataset.search||'').includes(q);const wasHidden=card.hidden;card.hidden=!visible;if(visible){if(wasHidden&&!matchMedia('(prefers-reduced-motion: reduce)').matches){card.classList.remove('filter-enter');void card.offsetWidth;card.style.setProperty('--filter-delay',String(Math.min(n,5)*35)+'ms');card.classList.add('filter-enter');}n++;}});const result=document.querySelector('#results');if(result)result.textContent=n+' product '+(n===1?'family':'families');const empty=document.querySelector<HTMLElement>('#empty');if(empty)empty.hidden=n!==0;}
const requestedSystem=new URLSearchParams(location.search).get('system');
if(requestedSystem&&Array.from(buttons).some(b=>b.dataset.filter===requestedSystem)){group=requestedSystem;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===group)));filter();}
search?.addEventListener('input',filter);buttons.forEach(b=>b.addEventListener('click',()=>{group=b.dataset.filter||'All';buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter();}));
</script>