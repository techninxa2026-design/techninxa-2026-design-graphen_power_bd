---
import Site from '../../layouts/Site.astro';
import ProductCard from '../../components/ProductCard.astro';
import {products,groups} from '../../data/catalog';
---
<Site title="Equipment catalogue"><section class="page-head"><div class="wrap"><a class="crumb" href="/">Home</a> / Products<div class="eyebrow light">01 / PRODUCT DIRECTORY</div><h1>Equipment<br/><em>that moves industry.</em></h1><p>Explore twelve product families, find the right equipment and prepare your technical requirements.</p></div></section><section class="wrap section catalogue"><div class="filterbar"><label class="search"><span>⌕</span><input type="search" id="product-search" placeholder="Search equipment, e.g. generator" aria-label="Search products"/></label><div class="filters" aria-label="Filter by system"><button data-filter="All" aria-pressed="true">All systems</button>{groups.map(group=><button data-filter={group} aria-pressed="false">{group}</button>)}</div></div><p id="results" class="result-count" aria-live="polite">12 product families</p><div class="product-grid">{products.map(product=><ProductCard {product}/>)}</div><p id="empty" hidden>No equipment matches. Try a different search or system.</p></section></Site>
<script>
let group='All';const search=document.querySelector<HTMLInputElement>('#product-search');const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const cards=document.querySelectorAll<HTMLElement>('[data-product]');
function filter(){let n=0;const q=(search?.value||'').trim().toLowerCase();cards.forEach(card=>{const visible=(group==='All'||card.dataset.group===group)&& (card.dataset.search||'').includes(q);card.hidden=!visible;if(visible)n++;});const result=document.querySelector('#results');if(result)result.textContent=n+' product '+(n===1?'family':'families');const empty=document.querySelector<HTMLElement>('#empty');if(empty)empty.hidden=n!==0;}
search?.addEventListener('input',filter);buttons.forEach(b=>b.addEventListener('click',()=>{group=b.dataset.filter||'All';buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter();}));
</script>