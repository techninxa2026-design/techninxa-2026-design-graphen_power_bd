---
import Site from '../layouts/Site.astro';
import ProductCard from '../components/ProductCard.astro';
import {products} from '../data/catalog';
import {heroPhoto,photos} from '../data/photos';
---
<Site>
<section class="hero photo-hero"><img class="hero-photo" src={heroPhoto} alt="Industrial power station at dusk" fetchpriority="high" width="612" height="459"/><div class="hero-grid"></div><div class="wrap hero-inner"><div class="hero-content"><div class="eyebrow light"><span class="signal"></span> INDUSTRIAL ENGINEERING / BANGLADESH</div><h1>Power.<br/>Precision.<br/><em>Progress.</em></h1><p>Explore the electrical, mechanical and thermal technologies that keep modern industry moving.</p><div class="actions"><a class="button" href="/products/">Explore equipment <span>↗</span></a><a class="button outline" href="/services/">Engineering services <span>→</span></a></div></div><div class="hero-visual"><div class="hero-note"><span class="hero-note-icon">↗</span><small>ENGINEERING PORTFOLIO</small><strong>12 product families.<br/>3 connected systems.</strong><a href="/products/">Discover the range →</a></div><span class="visual-tag">REFERENCE PHOTO / POWERBREEZE</span></div><div class="hero-bottom"><span>01 — 03 / SYSTEMS OF INDUSTRY</span><span>SCROLL TO EXPLORE ↓</span></div></div></section>
<div class="domain-strip"><div class="wrap"><span>01 <b>Electrical power</b></span><span>02 <b>Mechanical systems</b></span><span>03 <b>Thermal engineering</b></span></div></div>
<section class="wrap section"><div class="section-heading" data-reveal><div><div class="eyebrow">01 / EQUIPMENT PORTFOLIO</div><h2>Every component.<br/><em>One connected vision.</em></h2></div><a class="text-link" href="/products/">View all 12 categories ↗</a></div><div class="product-grid featured">{[products[0],products[1],products[8],products[4],products[5],products[7]].map(product=><ProductCard {product}/>)}</div></section>
<section class="feature-section"><div class="wrap feature-layout"><div class="feature-art"><img src={photos.transformers.src} alt={photos.transformers.alt} width="500" height="500" loading="lazy"/><small>REFERENCE PHOTO / POWERBREEZE</small></div><div data-reveal><div class="eyebrow light">02 / ENGINEERING SCOPE</div><h2>Beyond the<br/>equipment.</h2><p>Plan your industrial infrastructure as a connected system, from power distribution to mechanical installation and thermal management.</p><a class="button" href="/services/">Explore scope of work ↗</a></div></div></section>
<section class="wrap section"><div class="section-heading"><div><div class="eyebrow">03 / APPLICATIONS</div><h2>Built around<br/><em>industrial needs.</em></h2></div><a class="text-link" href="/solutions/">Explore solutions ↗</a></div><div class="solution-list">{[['01','Manufacturing','Production equipment, drives and compressed air.'],['02','Infrastructure','Electrical distribution, backup power and protection.'],['03','Process & HVAC','Cooling, heat transfer, ventilation and vacuum systems.']].map(([n,t,d])=><a href="/solutions/"><small>{n}</small><h3>{t}</h3><p>{d}</p><span>↗</span></a>)}</div></section>
<section class="cta-band"><div class="wrap"><div><div class="eyebrow">04 / NEXT STEP</div><h2>Build your project<br/>requirements.</h2></div><a class="button dark" href="/contact/">Prepare an inquiry ↗</a></div></section>
</Site>