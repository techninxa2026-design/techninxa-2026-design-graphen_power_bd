---
import Site from '../layouts/Site.astro';
import {pages} from '../data/pages';
export function getStaticPaths(){return pages.map(page=>({params:{section:page.slug},props:{page}}));}
const {page}=Astro.props;
---
<Site title={page.label} description={page.intro}><section class="page-head"><div class="wrap"><a class="crumb" href="/">Home</a> / {page.label}<div class="eyebrow light">GRAPHENE / {page.label.toUpperCase()}</div><h1>{page.heading}</h1><p>{page.intro}</p></div></section><section class="wrap section"><div class="section-heading"><h2>Explore {page.label.toLowerCase()}.</h2><a class="text-link" href="/products/">Product directory ↗</a></div><div class="editorial-list">{page.sections.map(([title,description],i)=><article><small>{String(i+1).padStart(2,'0')}</small><div><h3>{title}</h3><p>{description}</p></div></article>)}</div></section><section class="cta-band"><div class="wrap"><h2>Plan your requirements.</h2><a class="button dark" href="/contact/">Prepare inquiry ↗</a></div></section></Site>