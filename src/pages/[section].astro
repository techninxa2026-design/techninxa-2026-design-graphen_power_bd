---
import Site from '../layouts/Site.astro';
import {pages} from '../data/pages';
import {products} from '../data/catalog';
import {company} from '../data/company';
import BrandLogo from '../components/BrandLogo.astro';
import CompanyAddress from '../components/CompanyAddress.astro';
export function getStaticPaths(){return pages.map(page=>({params:{section:page.slug},props:{page}}));}
const {page}=Astro.props;
---
<Site title={page.label} description={page.intro}><section class="page-head"><div class="wrap"><a class="crumb" href="/">Home</a> / {page.label}<div class="eyebrow light">GRAPHENE / {page.label.toUpperCase()}</div><h1>{page.heading}</h1><p>{page.intro}</p></div></section>{page.slug==='about'&&<section class="wrap company-profile" aria-label="Company profile"><div class="company-profile-logo"><BrandLogo /><span>POWER ENGINEERING / BANGLADESH</span></div><div class="company-profile-facts"><div><small>ESTABLISHED</small><strong>{company.founded}</strong></div><div><small>BASED IN</small><strong>Dhaka</strong><span>Bangladesh</span></div><div><small>INDUSTRY EXPERTISE</small><strong>10+ years</strong></div></div><div class="company-profile-location"><small>COMPANY INFORMATION</small><CompanyAddress/><a class="text-link" href="/contact/">Contact GPE ↗</a></div></section>}<section class="wrap section"><div class="section-heading"><h2>Explore {page.label.toLowerCase()}.</h2><a class="text-link" href="/products/">Product directory ↗</a></div><div class="editorial-list">{page.sections.map(([title,description],i)=><article><small>{String(i+1).padStart(2,'0')}</small><div><h3>{title}</h3><p>{description}</p></div></article>)}</div></section>{page.slug==='resources'&&<section class="wrap section catalogue-library" id="catalogues"><div class="section-kicker"><span>01</span> / GRAPHENE DOCUMENT LIBRARY</div><div class="section-heading"><h2>Our equipment<br/><em>catalogues.</em></h2><a class="button dark" href="/catalogues/graphene-complete-portfolio.pdf" download>Download complete portfolio ↓</a></div><div class="brochure-grid">{products.map(p=><a href={'/catalogues/graphene-'+p.slug+'.pdf'} download><div class="brochure-cover"><span>GRAPHENE POWER ENGINEERING</span><strong>{p.name}</strong><small>{p.number} / TECHNICAL PORTFOLIO</small></div><div><h3>{p.name}</h3><span>Download PDF ↓</span></div></a>)}</div><p class="gallery-disclosure">Original Graphene selection guides. Indicative information; confirm final model specifications, supplier availability and compliance.</p></section>}<section class="cta-band"><div class="wrap"><h2>Plan your requirements.</h2><a class="button dark" href="/contact/">Prepare inquiry ↗</a></div></section></Site>