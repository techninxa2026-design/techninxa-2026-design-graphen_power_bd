---
import Site from '../layouts/Site.astro';
import { pages } from '../data/pages';
import { products } from '../data/catalog';
import { categoryUrl, serviceCategory } from '../data/categories';
import ProductCard from '../components/ProductCard.astro';
import { portfolioPhotos } from '../data/portfolio-photos';

export function getStaticPaths() {
  return pages.map(page => ({ params: { section: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const photoCredits = Object.values(portfolioPhotos);
---

<Site title={page.label} description={page.intro}>
  <section class="page-head">
    <div class="wrap">
      <a class="crumb" href="/">Home</a> / {page.label}
      <div class="eyebrow light">GRAPHENE / {page.label.toUpperCase()}</div>
      <h1>{page.heading}</h1>
      <p>{page.intro}</p>
    </div>
  </section>

  {page.slug === 'services' && (
    <section class="wrap section" id="engineering-services" aria-labelledby="engineering-heading">
      <div class="section-heading">
        <h2 id="engineering-heading">Engineering services</h2>
        <a class="text-link" href={categoryUrl(serviceCategory)}>Explore service offerings ↗</a>
      </div>
      <div class="product-grid">
        {products.filter(product => product.group === serviceCategory).map(product => <ProductCard {product} />)}
      </div>
    </section>
  )}

  <section class="wrap section">
    <div class="section-heading">
      <h2>Explore {page.label.toLowerCase()}.</h2>
      <a class="text-link" href="/products/">Product directory ↗</a>
    </div>
    <div class="editorial-list">
      {page.sections.map(([title, description], i) => (
        <article>
          <small>{String(i + 1).padStart(2, '0')}</small>
          <div><h3>{title}</h3><p>{description}</p></div>
        </article>
      ))}
    </div>
  </section>

  {page.slug === 'resources' && (
    <section class="wrap section catalogue-library" id="catalogues">
      <div class="section-heading">
        <h2>Equipment and service guides.</h2>
        <a class="button dark" href="/catalogues/graphene-complete-portfolio.pdf" download>Original portfolio PDF ↓</a>
      </div>
      <div class="brochure-grid">
        {products.map(product => (
          <a href={product.catalogue ?? `/products/${product.slug}/#technical`} download={product.catalogue ? true : undefined}>
            <div class="brochure-cover">
              <span>GRAPHENE POWER ENGINEERING</span>
              <strong>{product.name}</strong>
              <small>{product.group}</small>
            </div>
            <div><h3>{product.name}</h3><span>{product.catalogue ? 'Download PDF ↓' : 'View technical guide ↗'}</span></div>
          </a>
        ))}
      </div>
      <p class="gallery-disclosure">Use these guides to prepare your project brief.</p>
      <details class="photo-credits" id="photo-credits">
        <summary>Reference photo credits</summary>
        <p>These photographs show equipment and installation examples. Photos were resized and cropped for the website.</p>
        <ul>
          {photoCredits.map(photo => (
            <li>
              <a href={photo.source}>{photo.alt}</a>
              <span>{photo.credit} · {'licenseUrl' in photo ? <a href={photo.licenseUrl}>{photo.license}</a> : photo.license}</span>
            </li>
          ))}
        </ul>
      </details>
    </section>
  )}

  <section class="cta-band">
    <div class="wrap">
      <h2>Plan your requirements.</h2>
      <a class="button dark" href="/contact/">Prepare inquiry ↗</a>
    </div>
  </section>
</Site>

<style>
  .photo-credits {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 1rem 0;
  }
  .photo-credits summary { cursor: pointer; font-weight: 700; }
  .photo-credits p { margin-top: 1rem; }
  .photo-credits ul {
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: .75rem 1.5rem;
    margin-top: 1rem;
  }
  .photo-credits li { display: flex; flex-direction: column; font-size: .9rem; }
  .photo-credits a { text-decoration: underline; text-underline-offset: 3px; }
</style>
