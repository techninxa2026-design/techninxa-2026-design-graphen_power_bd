---
import Site from '../layouts/Site.astro';
import {products} from '../data/catalog';
import {equipment} from '../data/equipment';
---
<Site title="Project inquiry"><section class="page-head"><div class="wrap"><a class="crumb" href="/">Home</a> / Contact<div class="eyebrow light">START A PROJECT</div><h1>Let's talk<br/><em>engineering.</em></h1><p>Prepare a project brief for your equipment inquiry.</p></div></section><section class="wrap section contact-grid"><div><div class="eyebrow">PROJECT BRIEF</div><h2>Tell us what<br/>you need.</h2><p>This static tool prepares a downloadable inquiry. It does not send information or store your data on a server. Verified company contact details will be added once provided.</p></div><form id="inquiry"><label>Full name<input name="name" required autocomplete="name"/></label><label>Company<input name="company" autocomplete="organization"/></label><label>Email<input type="email" name="email" required autocomplete="email"/></label><label>Equipment<select name="product" id="equipment"><option value="">Select a product family</option>{products.map(p=><option value={p.slug}>{p.name}</option>)}</select></label><label>Specific equipment<select name="variant" id="variant"><option value="">Select equipment type (optional)</option>{equipment.map(item=><option value={item.name} data-family={item.family}>{item.name}</option>)}</select></label><label>Project requirements<textarea name="requirements" required rows="6" placeholder="Capacity, installation location, target delivery, technical specifications..."></textarea></label><button class="button dark" type="submit">Download inquiry brief ↓</button><p role="status" id="inquiry-status"></p></form></section></Site>
<script>
const form=document.querySelector<HTMLFormElement>('#inquiry');const select=document.querySelector<HTMLSelectElement>('#equipment');const requested=new URLSearchParams(location.search).get('product');if(select&&requested&&Array.from(select.options).some(o=>o.value===requested))select.value=requested;
const variant=document.querySelector<HTMLSelectElement>('#variant');function syncVariants(){if(!variant)return;for(const option of Array.from(variant.options)){if(!option.dataset.family)continue;option.hidden=!!select?.value&&option.dataset.family!==select.value;option.disabled=option.hidden;}if(variant.selectedOptions[0]?.disabled)variant.value='';}syncVariants();const v=new URLSearchParams(location.search).get('variant');if(variant&&v&&Array.from(variant.options).some(o=>o.value===v&&!o.disabled))variant.value=v;select?.addEventListener('change',syncVariants);
form?.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(form);const brief=['Graphene Power BD — Project inquiry','Name: '+data.get('name'),'Company: '+data.get('company'),'Email: '+data.get('email'),'Equipment: '+(select?.selectedOptions[0]?.textContent||''),'Equipment type: '+data.get('variant'),'Requirements: '+data.get('requirements')].join('\n\n');const url=URL.createObjectURL(new Blob([brief],{type:'text/plain;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download='graphene-project-inquiry.txt';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);const status=document.querySelector('#inquiry-status');if(status)status.textContent='Inquiry prepared for download. No information has been submitted.';});
</script>