---
import '../styles/site.css';
import '../styles/refinement.css';
import {heroPhoto} from '../data/photos';
import { products, groups } from '../data/catalog';
const {title='Industrial power & engineering', description='Explore electrical, mechanical and thermal engineering equipment with Graphene Power BD.'}=Astro.props;
const canonical=new URL(Astro.url.pathname, 'https://graphenepowerbd.com');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#101a19"/><link rel="canonical" href={canonical}/><link rel="icon" href="/mark.svg" type="image/svg+xml"/><title>{title} | Graphene Power BD</title></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="header"><div class="nav wrap"><a class="brand" href="/" aria-label="Graphene Power BD home"><img src="/mark.svg" alt="" width="45" height="45"/><span>GRAPHENE<strong>POWER <i>BD</i></strong></span></a><nav aria-label="Main navigation"><a href="/about/">Company</a><details class="mega"><summary><span>Products</span><svg width="15" height="15" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary><div class="mega-panel"><div class="mega-sidebar"><span class="mega-kicker">EXPLORE / 01</span><h3>Find your<br/>next system.</h3><div class="mega-switches" aria-label="Filter product families">{groups.map((group,i)=><button type="button" data-mega-group={group} aria-pressed={i===0?'true':'false'}><span><small>0{i+1}</small> {group}</span><span>↗</span></button>)}</div><a class="mega-all" href="/products/">View complete catalogue <span>↗</span></a></div><div class="mega-content">{groups.map(group=><section class="mega-group" data-mega-panel={group}><div class="mega-heading"><span>{group} systems</span><small>{products.filter(p=>p.group===group).length} families</small></div><div class="mega-links">{products.filter(p=>p.group===group).map(p=><a href={'/products/'+p.slug+'/'}><small>{p.number}</small><div><strong>{p.name}</strong><span>{p.variants.length} configurations</span></div><span class="mega-arrow">↗</span></a>)}</div></section>)}</div><a class="mega-feature" href="/products/"><img src={heroPhoto} alt="" loading="lazy" width="612" height="459"/><div><small>PRODUCT DIRECTORY</small><strong>Built for<br/>industry.</strong><span>Explore all 12 categories ↗</span></div></a></div></details><a href="/services/">Services</a><a href="/solutions/">Solutions</a><a href="/resources/">Resources</a></nav><a class="button nav-cta" href="/contact/">Discuss a project <span>↗</span></a><button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></div><div id="mobile-nav" hidden class="mobile-nav"><a href="/about/">Company</a><details class="mobile-products"><summary>Products <span>+</span></summary><div class="mobile-catalogue"><a href="/products/">All product families ↗</a>{groups.map(group=><section><h4>{group}</h4>{products.filter(p=>p.group===group).map(p=><a href={'/products/'+p.slug+'/'}>{p.name} <span>↗</span></a>)}</section>)}</div></details><a href="/services/">Services</a><a href="/solutions/">Solutions</a><a href="/resources/">Resources</a><a href="/contact/">Discuss a project ↗</a></div></header>
<main id="main"><slot/></main>
<footer class="footer"><div class="wrap footer-main"><div><a class="brand" href="/"><img src="/mark.svg" alt="" width="45" height="45"/><span>GRAPHENE<strong>POWER <i>BD</i></strong></span></a><h2>Powering what<br/>comes next.</h2></div><div><h4>Explore</h4><a href="/products/">Product catalogue</a><a href="/services/">Engineering services</a><a href="/solutions/">Industrial solutions</a></div><div><h4>Company</h4><a href="/about/">About</a><a href="/resources/">Resources & media</a><a href="/contact/">Contact</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Graphene Power BD</span><a href="#main">Back to top ↑</a></div></footer>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
const mobile=document.querySelector<HTMLElement>('#mobile-nav');
toggle?.addEventListener('click',()=>{if(!mobile)return;mobile.hidden=!mobile.hidden;toggle.setAttribute('aria-expanded',String(!mobile.hidden));toggle.setAttribute('aria-label',mobile.hidden?'Open navigation':'Close navigation');});
const mega=document.querySelector<HTMLDetailsElement>('.mega');
const choices=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mega-group]'));
const panels=Array.from(document.querySelectorAll<HTMLElement>('[data-mega-panel]'));
function selectGroup(group:string){choices.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.megaGroup===group)));panels.forEach(p=>p.hidden=p.dataset.megaPanel!==group);}
if(choices[0])selectGroup(choices[0].dataset.megaGroup||'Electrical');
choices.forEach(b=>b.addEventListener('click',()=>selectGroup(b.dataset.megaGroup||'Electrical')));
document.querySelectorAll<HTMLImageElement>('.equipment-photo img').forEach(img=>{function failed(){img.hidden=true;const container=img.closest('.equipment-photo');container?.classList.add('photo-missing');const fallback=container?.querySelector<HTMLElement>('.photo-fallback');if(fallback)fallback.hidden=false;}img.addEventListener('error',failed);if(img.complete&&!img.naturalWidth)failed();});
document.addEventListener('click',e=>{if(mega && e.target instanceof Node && !mega.contains(e.target))mega.open=false;});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(mega?.open){mega.open=false;mega.querySelector('summary')?.focus();}if(mobile&&!mobile.hidden){mobile.hidden=true;toggle?.setAttribute('aria-expanded','false');toggle?.setAttribute('aria-label','Open navigation');toggle?.focus();}}});
if(!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('arrived');observer.unobserve(e.target);}}),{threshold:.1});document.querySelectorAll('[data-reveal]').forEach(el=>observer.observe(el));}
</script>
</body></html>