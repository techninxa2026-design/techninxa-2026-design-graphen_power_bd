---
import '../styles/site.css';
import '../styles/refinement.css';
import '../styles/motion.css';
import '../styles/experience.css';
import '../styles/theme.css';
import '../styles/choreography.css';
import '../styles/gallery.css';
import '../styles/cursor.css';
import '../styles/sequence.css';
import '../styles/kinetic.css';
import '../styles/navigation-transition.css';
import '../styles/company.css';
import '../styles/responsive.css';
import BrandLogo from '../components/BrandLogo.astro';
import CompanyAddress from '../components/CompanyAddress.astro';
import CompanyPhone from '../components/CompanyPhone.astro';
import {company} from '../data/company';
import { brand } from '../data/brand';
import { brandPalette } from '../data/theme';
import NavigationCurtain from '../components/NavigationCurtain.astro';
import ThemePanel from '../components/ThemePanel.astro';
import { portfolioPhotos } from '../data/portfolio-photos';
import { products, groups } from '../data/catalog';
import { serviceCategory } from '../data/categories';
const {title='Industrial power & engineering', description='Graphene Power Engineering (GPE), established in 2014 in Dhaka, Bangladesh, provides power engineering and distribution solutions.'}=Astro.props;
const isNotFound=/^\/404(?:\.html|\/)?$/.test(Astro.url.pathname);
const canonical=new URL(isNotFound?'/404.html':Astro.url.pathname, company.website);
const paletteStyle = Object.fromEntries(Object.entries(brandPalette).map(([name, color]) => ['--palette-' + name, color]));
const logoUrl = new URL(brand.logo.src, company.website).href;
const organization={ '@context':'https://schema.org','@type':'Organization',name:company.name,alternateName:company.shortName,url:company.website,logo:logoUrl,foundingDate:String(company.founded),telephone:company.phoneHref,address:{'@type':'PostalAddress',streetAddress:company.address.join(' '),addressLocality:company.city,postalCode:company.postalCode,addressCountry:'BD'},description:company.profile};
---
<!doctype html>
<html lang="en" style={paletteStyle}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content={brandPalette.primary}/><link rel="canonical" href={canonical}/>{isNotFound&&<meta name="robots" content="noindex, follow"/>}<link rel="icon" href={brand.icon.src} type="image/png" sizes={brand.icon.width + "x" + brand.icon.height}/><meta property="og:site_name" content={company.name}/><meta property="og:title" content={title+' | '+company.name}/><meta property="og:description" content={description}/><meta property="og:image" content={logoUrl}/><meta property="og:url" content={canonical.href}/><script type="application/ld+json" set:html={JSON.stringify(organization)} /><title>{title} | {company.name}</title><script is:inline src="/theme.js"></script><script is:inline src="/navigation-bootstrap.js"></script></head>
<body>
<NavigationCurtain />
<a class="skip" href="#main">Skip to content</a>
<header class="header"><div class="nav wrap"><a class="brand" href="/" aria-label={company.name+' home'}><BrandLogo /></a><nav aria-label="Main navigation"><a href="/about/">Company</a><details class="mega"><summary><span>Products</span><svg width="15" height="15" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary><div class="mega-panel"><div class="mega-sidebar"><span class="mega-kicker">EXPLORE / 01</span><h3>Find your<br/>next system.</h3><div class="mega-switches" aria-label="Filter product families">{groups.map((group,i)=><button type="button" data-mega-group={group} aria-pressed={i===0?'true':'false'}><span>{group}</span><span aria-hidden="true">↗</span></button>)}</div><a class="mega-all" href="/products/">View complete catalogue <span>↗</span></a><a class="mega-all" href="/products/gallery/">Visual equipment library <span>↗</span></a></div><div class="mega-content">{groups.map(group=><section class="mega-group" data-mega-panel={group}><div class="mega-heading"><span>{group}</span><small>{products.filter(p=>p.group===group).length} {group === serviceCategory ? 'services' : 'families'}</small></div><div class="mega-links">{products.filter(p=>p.group===group).map(p=><a href={'/products/'+p.slug+'/'}><small>{p.number}</small><div><strong>{p.name}</strong><span>{p.variants.length} {p.group === serviceCategory ? 'services' : 'configurations'}</span></div><span class="mega-arrow">↗</span></a>)}</div></section>)}</div><a class="mega-feature" href="/products/"><img src={portfolioPhotos.substationTransformer.src} alt="" loading="lazy" width={portfolioPhotos.substationTransformer.width} height={portfolioPhotos.substationTransformer.height}/><div><small>PRODUCT DIRECTORY</small><strong>Built for<br/>industry.</strong><span>Explore all {products.length} offerings ↗</span></div></a></div></details><a href="/services/">Services</a><a href="/solutions/">Solutions</a><a href="/resources/">Resources</a></nav><div class="nav-tools">
<button class="theme-launch" type="button" id="theme-launch" data-theme-launch aria-controls="theme-dialog" aria-label="Customize website theme" aria-haspopup="dialog" title="Website theme" hidden><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18h1.2a2 2 0 0 0 1.5-3.3 1.7 1.7 0 0 1 1.3-2.8h2A3.9 3.9 0 0 0 22 11c0-4.4-4.5-8-10-8Z"/><circle cx="7.6" cy="10" r="1"/><circle cx="11" cy="6.8" r="1"/><circle cx="16" cy="7.5" r="1"/><circle cx="7.5" cy="15" r="1"/></svg></button>
<div class="nav-contact-actions"><CompanyPhone className="nav-phone"/><a class="button nav-cta" href="/contact/">Discuss a project <span aria-hidden="true">→</span></a></div>
</div>
<button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></div><nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
  <a href="/about/">Company</a>
  <details class="mobile-products">
    <summary>Products <span aria-hidden="true">+</span></summary>
    <div class="mobile-catalogue">
      <a href="/products/">All products and services <span aria-hidden="true">↗</span></a>
      <a href="/products/gallery/">Visual equipment library <span aria-hidden="true">↗</span></a>
      {groups.map(group => (
        <details class="mobile-category" name="mobile-product-category" data-mobile-group={group}>
          <summary>
            {group}
            <svg width="15" height="15" viewBox="0 0 20 20" aria-hidden="true" fill="none">
              <path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          {products.filter(product => product.group === group).map(product => (
            <a href={`/products/${product.slug}/`}>{product.name} <span aria-hidden="true">↗</span></a>
          ))}
        </details>
      ))}
    </div>
  </details>
  <a href="/services/">Services</a>
  <a href="/solutions/">Solutions</a>
  <a href="/resources/">Resources</a>
  <button class="mobile-theme-launch" type="button" data-theme-launch aria-haspopup="dialog" aria-controls="theme-dialog" aria-label="Customize website theme" hidden>Website theme</button>
  <a href="/contact/">Discuss a project <span aria-hidden="true">↗</span></a>
  <CompanyPhone className="mobile-contact-phone" />
</nav></header>
<main id="main"><slot/></main>
<ThemePanel />
<aside class="energy-rail" aria-label="Page navigation" hidden><span class="rail-count" aria-hidden="true">01</span><div class="rail-track" aria-hidden="true"><div class="rail-fill"></div></div><nav class="rail-stops" aria-label="Page sections"></nav><button type="button" class="rail-top" aria-label="Scroll to top">↑</button></aside>
<footer class="footer"><div class="wrap footer-main"><div><a class="brand" href="/"><BrandLogo sizes="(max-width: 760px) 190px, 240px" /></a><h2>Powering what<br/>comes next.</h2><CompanyAddress compact={true}/></div><div><h4>Explore</h4><a href="/products/">Product catalogue</a><a href="/products/gallery/">Visual equipment library</a><a href="/services/">Engineering services</a><a href="/solutions/">Industrial solutions</a></div><div><h4>Company</h4><a href="/about/">About</a><a href="/resources/">Resources & media</a><a href="/contact/">Contact</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {company.name}</span><a href="#main">Back to top ↑</a></div></footer>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
const mobile = document.querySelector<HTMLElement>('#mobile-nav');
const themeDialog = document.querySelector<HTMLDialogElement>('#theme-dialog');
const mobileViewport = matchMedia('(max-width: 1050px)');

function setMobileNav(open: boolean) {
  if (!mobile || !toggle) return;
  mobile.hidden = !open;
  toggle.setAttribute('aria-expanded', String(open));
  toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
}

toggle?.addEventListener('click', () => setMobileNav(mobile?.hidden ?? false));
mobileViewport.addEventListener('change', event => {
  if (!event.matches) setMobileNav(false);
});
const mega=document.querySelector<HTMLDetailsElement>('.mega');
const choices=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mega-group]'));
const panels=Array.from(document.querySelectorAll<HTMLElement>('[data-mega-panel]'));
function selectGroup(group:string){choices.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.megaGroup===group)));panels.forEach(p=>{const wasHidden=p.hidden;p.hidden=p.dataset.megaPanel!==group;if(!p.hidden&&wasHidden&&!matchMedia('(prefers-reduced-motion: reduce)').matches){p.classList.remove('filter-enter');void p.offsetWidth;p.classList.add('filter-enter');}});}
if(choices[0])selectGroup(choices[0].dataset.megaGroup||'Electrical');
choices.forEach(b=>b.addEventListener('click',()=>selectGroup(b.dataset.megaGroup||'Electrical')));
document.querySelectorAll<HTMLImageElement>('.equipment-photo img').forEach(img=>{function failed(){img.hidden=true;const container=img.closest('.equipment-photo');container?.classList.add('photo-missing');const fallback=container?.querySelector<HTMLElement>('.photo-fallback');if(fallback)fallback.hidden=false;}img.addEventListener('error',failed);if(img.complete&&!img.naturalWidth)failed();});
document.addEventListener('click', event => {
  if (!(event.target instanceof Node)) return;
  if (mega && !mega.contains(event.target)) mega.open = false;
  if (mobile && !mobile.hidden && !mobile.parentElement?.contains(event.target) && !themeDialog?.contains(event.target)) {
    setMobileNav(false);
  }
});
document.addEventListener('keydown', event => {
  if (event.key !== 'Escape' || themeDialog?.open) return;
  if (mega?.open) {
    mega.open = false;
    mega.querySelector('summary')?.focus();
  }
  if (mobile && !mobile.hidden) {
    setMobileNav(false);
    toggle?.focus();
  }
});
if(!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('arrived');observer.unobserve(e.target);}}),{threshold:.1});document.querySelectorAll('[data-reveal]').forEach(el=>observer.observe(el));}
</script>
<script>
import '../lib/experience';
import '../lib/cursor';
import '../lib/sequence';
import '../lib/kinetic';
import '../lib/navigation-transition';
document.querySelectorAll<HTMLImageElement>('.tile-photo img').forEach(img=>{
const parent=img.closest<HTMLAnchorElement>('.tile-photo');let alternates:{src:string;alt:string;credit:string;source:string;width:number;height:number;license?:string}[]=[];try{alternates=JSON.parse(img.dataset.imageFallbacks||'[]');}catch{}
function fail(){const next=alternates.shift();if(next&&parent){img.alt=next.alt;img.width=next.width||640;img.height=next.height||420;parent.href=next.src;parent.setAttribute('aria-label','Open reference image: '+next.alt);parent.classList.toggle('tile-thumbnail',next.width>0&&next.width<400);const label=parent.querySelector('.tile-photo-label');if(label)label.textContent='Related family example · '+next.credit;const attribution=parent.closest('.equipment-tile')?.querySelector<HTMLAnchorElement>('.image-attribution');if(attribution){attribution.href=next.source;attribution.textContent='Image: '+next.alt+' · '+next.credit+(next.license?' · '+next.license:'')+' ↗';}img.src=next.src;return;}img.hidden=true;parent?.classList.add('image-failed');const msg=parent?.querySelector<HTMLElement>('.tile-unavailable');if(msg)msg.hidden=false;}
img.addEventListener('error',fail);if(img.complete&&!img.naturalWidth)fail();});
</script>
</body></html>