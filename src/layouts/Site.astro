---
import '../styles/site.css';
import '../styles/refinement.css';
import '../styles/motion.css';
import '../styles/experience.css';
import '../styles/theme.css';
import '../styles/choreography.css';
import '../styles/gallery.css';
import '../styles/cursor.css';
import '../styles/sequence.css';
import '../styles/kinetic.css';
import '../styles/scroll-story.css';
import ThemePanel from '../components/ThemePanel.astro';
import {heroPhoto} from '../data/photos';
import { products, groups } from '../data/catalog';
const {title='Industrial power & engineering', description='Explore electrical, mechanical and thermal engineering equipment with Graphene Power BD.'}=Astro.props;
const canonical=new URL(Astro.url.pathname, 'https://graphenepowerbd.com');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#101b43"/><link rel="canonical" href={canonical}/><link rel="icon" href="/mark.svg" type="image/svg+xml"/><title>{title} | Graphene Power BD</title><script is:inline src="/theme.js"></script></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="header"><div class="nav wrap"><a class="brand" href="/" aria-label="Graphene Power BD home"><svg class="brand-mark" width="45" height="45" viewBox="0 0 48 48" aria-hidden="true"><path fill="var(--cyan)" d="M24 2 45 14v20L24 46 3 34V14Zm0 8L10 18v12l14 8 14-8v-8H24v7h6l-6 3-7-4v-8l7-4 9 5 5-5Z"/><path fill="var(--orange)" d="M39 4h5v10h-5zM36.5 6.5h10v5h-10z"/></svg><span>GRAPHENE<strong>POWER <i>BD</i></strong></span></a><nav aria-label="Main navigation"><a href="/about/">Company</a><details class="mega"><summary><span>Products</span><svg width="15" height="15" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary><div class="mega-panel"><div class="mega-sidebar"><span class="mega-kicker">EXPLORE / 01</span><h3>Find your<br/>next system.</h3><div class="mega-switches" aria-label="Filter product families">{groups.map((group,i)=><button type="button" data-mega-group={group} aria-pressed={i===0?'true':'false'}><span><small>0{i+1}</small> {group}</span><span>↗</span></button>)}</div><a class="mega-all" href="/products/">View complete catalogue <span>↗</span></a><a class="mega-all" href="/products/gallery/">Visual equipment library <span>↗</span></a></div><div class="mega-content">{groups.map(group=><section class="mega-group" data-mega-panel={group}><div class="mega-heading"><span>{group} systems</span><small>{products.filter(p=>p.group===group).length} families</small></div><div class="mega-links">{products.filter(p=>p.group===group).map(p=><a href={'/products/'+p.slug+'/'}><small>{p.number}</small><div><strong>{p.name}</strong><span>{p.variants.length} configurations</span></div><span class="mega-arrow">↗</span></a>)}</div></section>)}</div><a class="mega-feature" href="/products/"><img src={heroPhoto} alt="" loading="lazy" width="612" height="459"/><div><small>PRODUCT DIRECTORY</small><strong>Built for<br/>industry.</strong><span>Explore all 12 categories ↗</span></div></a></div></details><a href="/services/">Services</a><a href="/solutions/">Solutions</a><a href="/resources/">Resources</a></nav><a class="button nav-cta" href="/contact/">Discuss a project <span>↗</span></a><button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></div><div id="mobile-nav" hidden class="mobile-nav"><a href="/about/">Company</a><details class="mobile-products"><summary>Products <span>+</span></summary><div class="mobile-catalogue"><a href="/products/">All product families ↗</a><a href="/products/gallery/">Visual equipment library ↗</a>{groups.map(group=><section><h4>{group}</h4>{products.filter(p=>p.group===group).map(p=><a href={'/products/'+p.slug+'/'}>{p.name} <span>↗</span></a>)}</section>)}</div></details><a href="/services/">Services</a><a href="/solutions/">Solutions</a><a href="/resources/">Resources</a><a href="/contact/">Discuss a project ↗</a></div></header>
<main id="main"><slot/></main>
<ThemePanel />
<aside class="energy-rail" aria-label="Page navigation" hidden><span class="rail-count" aria-hidden="true">01</span><div class="rail-track" aria-hidden="true"><div class="rail-fill"></div></div><nav class="rail-stops" aria-label="Page sections"></nav><button type="button" class="rail-top" aria-label="Scroll to top">↑</button></aside>
<footer class="footer"><div class="wrap footer-main"><div><a class="brand" href="/"><svg class="brand-mark" width="45" height="45" viewBox="0 0 48 48" aria-hidden="true"><path fill="var(--cyan)" d="M24 2 45 14v20L24 46 3 34V14Zm0 8L10 18v12l14 8 14-8v-8H24v7h6l-6 3-7-4v-8l7-4 9 5 5-5Z"/><path fill="var(--orange)" d="M39 4h5v10h-5zM36.5 6.5h10v5h-10z"/></svg><span>GRAPHENE<strong>POWER <i>BD</i></strong></span></a><h2>Powering what<br/>comes next.</h2></div><div><h4>Explore</h4><a href="/products/">Product catalogue</a><a href="/products/gallery/">Visual equipment library</a><a href="/services/">Engineering services</a><a href="/solutions/">Industrial solutions</a></div><div><h4>Company</h4><a href="/about/">About</a><a href="/resources/">Resources & media</a><a href="/contact/">Contact</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Graphene Power BD</span><a href="#main">Back to top ↑</a></div></footer>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
const mobile=document.querySelector<HTMLElement>('#mobile-nav');
toggle?.addEventListener('click',()=>{if(!mobile)return;mobile.hidden=!mobile.hidden;toggle.setAttribute('aria-expanded',String(!mobile.hidden));toggle.setAttribute('aria-label',mobile.hidden?'Open navigation':'Close navigation');});
const mega=document.querySelector<HTMLDetailsElement>('.mega');
const choices=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mega-group]'));
const panels=Array.from(document.querySelectorAll<HTMLElement>('[data-mega-panel]'));
function selectGroup(group:string){choices.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.megaGroup===group)));panels.forEach(p=>{const wasHidden=p.hidden;p.hidden=p.dataset.megaPanel!==group;if(!p.hidden&&wasHidden&&!matchMedia('(prefers-reduced-motion: reduce)').matches){p.classList.remove('filter-enter');void p.offsetWidth;p.classList.add('filter-enter');}});}
if(choices[0])selectGroup(choices[0].dataset.megaGroup||'Electrical');
choices.forEach(b=>b.addEventListener('click',()=>selectGroup(b.dataset.megaGroup||'Electrical')));
document.querySelectorAll<HTMLImageElement>('.equipment-photo img').forEach(img=>{function failed(){img.hidden=true;const container=img.closest('.equipment-photo');container?.classList.add('photo-missing');const fallback=container?.querySelector<HTMLElement>('.photo-fallback');if(fallback)fallback.hidden=false;}img.addEventListener('error',failed);if(img.complete&&!img.naturalWidth)failed();});
document.addEventListener('click',e=>{if(mega && e.target instanceof Node && !mega.contains(e.target))mega.open=false;});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(mega?.open){mega.open=false;mega.querySelector('summary')?.focus();}if(mobile&&!mobile.hidden){mobile.hidden=true;toggle?.setAttribute('aria-expanded','false');toggle?.setAttribute('aria-label','Open navigation');toggle?.focus();}}});
if(!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('arrived');observer.unobserve(e.target);}}),{threshold:.1});document.querySelectorAll('[data-reveal]').forEach(el=>observer.observe(el));}
</script>
<script>
import '../lib/experience';
import '../lib/cursor';
import '../lib/sequence';
import '../lib/kinetic';
import '../lib/scroll-story';
document.querySelectorAll<HTMLImageElement>('.tile-photo img').forEach(img=>{
const parent=img.closest<HTMLAnchorElement>('.tile-photo');let alternates:{src:string;alt:string;credit:string;source:string;width:number;height:number;license?:string}[]=[];try{alternates=JSON.parse(img.dataset.imageFallbacks||'[]');}catch{}
function fail(){const next=alternates.shift();if(next&&parent){img.alt=next.alt;img.width=next.width||640;img.height=next.height||420;parent.href=next.src;parent.setAttribute('aria-label','Open reference image: '+next.alt);parent.classList.toggle('tile-thumbnail',next.width>0&&next.width<400);const label=parent.querySelector('.tile-photo-label');if(label)label.textContent='Related family example · '+next.credit;const attribution=parent.closest('.equipment-tile')?.querySelector<HTMLAnchorElement>('.image-attribution');if(attribution){attribution.href=next.source;attribution.textContent='Image: '+next.alt+' · '+next.credit+(next.license?' · '+next.license:'')+' ↗';}img.src=next.src;return;}img.hidden=true;parent?.classList.add('image-failed');const msg=parent?.querySelector<HTMLElement>('.tile-unavailable');if(msg)msg.hidden=false;}
img.addEventListener('error',fail);if(img.complete&&!img.naturalWidth)fail();});
</script>
</body></html>